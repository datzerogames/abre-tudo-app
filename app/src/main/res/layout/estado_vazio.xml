<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="32dp">

    <FrameLayout
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:background="@drawable/tile_fundo">

        <ImageView
            android:id="@+id/vazioIcone"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_gravity="center"
            android:src="@android:drawable/btn_star_big_off"
            app:tint="@color/app_tile_icone" />

    </FrameLayout>

    <TextView
        android:id="@+id/vazioTitulo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:textColor="@color/app_texto"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/vazioTexto"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:textColor="@color/app_texto_secundario"
        android:textSize="15sp" />

</LinearLayout>
